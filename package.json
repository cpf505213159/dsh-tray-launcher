{
  "name": "dsh-tray-launcher",
  "version": "1.5.4",
  "description": "DeepSeek Harness 的 Windows 桌面托盘启动器（纯 PowerShell，零安装包、零运行时、实测常驻 55MB）：无窗口运行 dsh web，自动处理新版鉴权地址，托盘显示 DeepSeek 品牌蓝鲸鱼图标，右键开机自启、重启 Harness。同时以 dsh 插件形式提供（dsh plugin add 后托盘随 Harness 自动启动）。",
  "license": "MIT",
  "author": "fancr-code",
  "type": "module",
  "main": "src/plugin.js",
  "exports": {
    ".": "./src/plugin.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-tray": "bin/dsh-tray.js",
    "dsh-tray-install": "bin/dsh-tray-install.js"
  },
  "scripts": {
    "test": "node scripts/check-bom.mjs"
  },
  "files": [
    "src/plugin.js",
    "cordis.patch.yml",
    "tray.ps1",
    "launch-hidden.vbs",
    "install.ps1",
    "uninstall.ps1",
    "安装.bat",
    "卸载.bat",
    "launch.bat",
    "lib/TrayTheme.cs",
    "icons/deepseek.ico",
    "bin/dsh-tray.js",
    "bin/dsh-tray-install.js",
    "scripts/check-bom.mjs",
    "docs/deepseek.png",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cpf505213159/dsh-tray-launcher.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "windows",
    "system-tray",
    "launcher",
    "powershell"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
